---
import "../styles/global.css";

const title = "Wandi Susanto — ML Engineer, Data Scientist & Tech Entrepreneur";
const description =
  "Wandi Susanto: tech entrepreneur, ML Engineer & Data Scientist with 16+ years in Germany and Singapore. Hire me for AI/ML, data, fullstack & automation.";
const ogImage = new URL("/og.png", Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Wandi Susanto",
  url: Astro.site?.href,
  image: "https://github.com/wandisusanto.png",
  jobTitle: "Machine Learning Engineer & Data Scientist",
  description,
  alumniOf: { "@type": "ResearchOrganization", name: "Max Planck Institute for Informatics" },
  knowsAbout: [
    "Machine Learning",
    "Data Science",
    "Artificial Intelligence",
    "Multi-agent Systems",
    "Chatbots",
    "Personalization",
    "Natural Language Processing",
    "Computer Vision",
    "Large Language Models",
    "Fullstack Web Development",
    "Mobile App Development",
    "E-commerce",
    "Workflow Automation",
  ],
  sameAs: [
    "https://id.linkedin.com/in/wandisusanto",
    "https://github.com/wandisusanto",
    "https://x.com/wandikang",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site} />
    <meta name="theme-color" content="#07090c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wandi Susanto" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wandi Susanto — ML Engineer, Data Scientist & Tech Entrepreneur" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wandikang" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      // Hide .reveal elements only when JS runs, then fade each in as it scrolls into view.
      document.documentElement.classList.add("js");
      addEventListener("DOMContentLoaded", () => {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }),
          { rootMargin: "0px 0px -60px 0px" },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>
