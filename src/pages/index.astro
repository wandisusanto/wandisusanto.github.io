---
import Layout from "../layouts/Layout.astro";

const avatar = "https://github.com/wandisusanto.png";

const nav = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];

const socials = [
  {
    label: "LinkedIn",
    href: "https://id.linkedin.com/in/wandisusanto",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "GitHub",
    href: "https://github.com/wandisusanto",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "Threads",
    href: "https://www.threads.com/@wandikang",
    path: "M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z",
  },
  {
    label: "X",
    href: "https://x.com/wandikang",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
];

const stats = [
  { value: "16+", label: "years experience" },
  { value: "DE · SG", label: "Germany & Singapore" },
  { value: "Max Planck", label: "Institute alumnus" },
];

const formerEmployers = ["Alibaba/Lazada", "AstraZeneca", "Traveloka"];

const offerings = [
  { title: "Strategic Consulting", desc: "Tech roadmaps and digital strategy to scale your business." },
  { title: "Developer Sourcing", desc: "Recruiting vetted technical talent to execute your vision." },
  { title: "Partnerships & Growth", desc: "Exploring joint ventures and collaborative business growth." },
];

// Icon bodies are Lucide (24x24, stroke) paths.
const services = [
  {
    title: "AI & Machine Learning",
    tagline: "Intelligent automation and predictive insights for smarter business decisions.",
    desc: "From chatbots and autonomous AI agents to personalized recommendations, forecasting and computer vision — practical AI that saves your team time and grows revenue, built securely for production.",
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
  },
  {
    title: "Custom Web & Mobile Apps",
    tagline: "Modern custom software built around how your business actually works.",
    desc: "Customer-facing apps, internal tools and client portals — taken from idea to launch, on reliable cloud infrastructure that grows with you.",
    icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 4v4"/><path d="M2 8h20"/><path d="M6 4v4"/>',
  },
  {
    title: "E-commerce Stores",
    tagline: "High-performance digital storefronts designed to convert and scale.",
    desc: "Fast, polished online stores with secure payments, inventory and the integrations you need — so more visitors become paying customers.",
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: "Data Science & Analytics",
    tagline: "Turning your business data into actionable growth strategies.",
    desc: "Clear dashboards, reliable reporting and models that show what's working, what isn't, and where your next opportunity is.",
    icon: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  },
  {
    title: "Workflow Automation",
    tagline: "Streamlining operations to reduce costs and eliminate manual work.",
    desc: "Connect the tools you already use and automate repetitive tasks — fewer errors, faster turnaround, and a team free to focus on growth.",
    icon: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  },
];

const projects = [
  {
    name: "MyBankStatementConverter.com",
    href: "https://mybankstatementconverter.com",
    tag: "SaaS · Solo-developed",
    desc: "Converts bank statement PDFs into clean Excel or CSV spreadsheets in seconds. Built for accountants and bookkeepers, with batch uploads and privacy by design — transaction data never enters the database.",
  },
];

const experience = [
  { org: "MyBankStatementConverter.com", role: "Founder & solopreneur" },
  { org: "Doctor Anywhere", role: "Head of AI & Data Science", location: "Singapore" },
  { org: "Alibaba / Lazada", role: "Senior Manager, Machine Learning & Data Science", location: "Singapore" },
  { org: "Traveloka", role: "Principal Data Scientist", location: "Singapore" },
  { org: "AstraZeneca", role: "Lead Data Scientist", location: "Germany" },
  { org: "Max Planck Institute for Informatics", role: "Graduate studies & research", location: "Germany" },
];

---

<Layout>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-ink/70 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
      <a href="#about" class="font-serif text-2xl tracking-tight text-fg">Wandi Susanto</a>
      <div class="flex items-center gap-2 md:gap-8">
        <ul class="hidden gap-8 text-sm text-mist md:flex">
          {nav.map((n) => <li><a href={n.href} class="transition-colors hover:text-fg">{n.label}</a></li>)}
        </ul>
        <button type="button" onclick="toggleTheme()" class="rounded-lg p-2 text-mist transition-colors hover:text-fg md:-mr-2" aria-label="Toggle light/dark theme">
          <svg class="size-5 light:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          <svg class="hidden size-5 light:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
        </button>
        <details class="group relative md:hidden">
          <summary class="cursor-pointer list-none rounded-lg p-2 text-mist hover:text-fg [&::-webkit-details-marker]:hidden" aria-label="Menu">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </summary>
          <ul onclick="this.closest('details').open = false" class="absolute right-0 mt-3 w-48 rounded-xl border border-line bg-panel/95 p-2 text-sm shadow-2xl backdrop-blur-xl">
            {nav.map((n) => <li><a href={n.href} class="block rounded-lg px-3 py-2 text-mist hover:bg-surface hover:text-fg">{n.label}</a></li>)}
          </ul>
        </details>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero / About -->
    <section id="about" class="relative overflow-hidden pt-32 pb-24 sm:pt-40 sm:pb-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="aurora absolute -inset-x-1/4 -top-1/4 h-[120%]"></div>
        <div class="grid-bg absolute inset-0"></div>
      </div>

      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
        <div class="rise">
          <div class="relative mx-auto size-32 sm:size-40">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-emerald-400 via-teal-400 to-cyan-400 opacity-70 blur-md"></div>
            <img
              src={avatar}
              alt="Portrait of Wandi Susanto"
              width="160"
              height="160"
              fetchpriority="high"
              class="relative size-full rounded-full border-2 border-ink object-cover"
            />
          </div>
        </div>

        <div class="rise" style="--d: 0.1s">
          <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/5 px-4 py-1.5 text-xs font-medium tracking-wide text-accent">
            <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
            Partnering with select founders & executives
          </p>
          <h1 class="mt-6 text-2xl font-semibold tracking-tight text-fg sm:text-4xl">
            Hi, I’m Wandi.<br />
            <span class="mt-2 inline-block font-serif text-4xl leading-[1.1] font-normal italic sm:text-[3.5rem]"><span class="text-gradient">AI Architect <br class="sm:hidden" />&amp; Strategic Partner<span class="sr-only">.</span></span></span>
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-soft sm:text-xl">
            I help businesses grow faster by combining strategic AI consulting with custom software development.
            As your advisory and technical partner, I architect and deliver secure, scalable AI systems and
            products—multiplying your output without expanding your team.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="#contact" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-emerald-400 to-teal-400 px-6 py-3 text-sm font-semibold text-slate-950 shadow-[0_8px_30px_-8px_rgb(52_211_153/0.6)] transition hover:brightness-110">Let's talk →</a>
            <a href="#services" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-6 py-3 text-sm font-medium text-soft transition hover:border-emerald-400/40 hover:bg-emerald-400/10 hover:text-fg">See services</a>
          </div>
        </div>

        <div class="rise" style="--d: 0.2s">
          <div class="mx-auto mt-14 grid max-w-2xl grid-cols-3 divide-x divide-line">
            {stats.map((st) => (
              <div class="px-2">
                <p class="font-serif text-2xl italic text-gradient sm:text-4xl">{st.value}</p>
                <p class="mt-1 text-xs text-mist sm:text-sm">{st.label}</p>
              </div>
            ))}
          </div>
          <p class="mt-10 text-xs font-medium tracking-widest text-mist uppercase">Previously at</p>
          <p class="mx-auto mt-3 flex max-w-2xl flex-wrap justify-center gap-x-6 gap-y-2 font-medium text-soft">
            {formerEmployers.map((name) => <span>{name}</span>)}
          </p>
          <p class="mx-auto mt-10 max-w-2xl text-base leading-relaxed text-mist sm:text-lg">
            As a founder, I single-handedly designed, built and launched{" "}
            <a href="https://mybankstatementconverter.com" target="_blank" rel="noopener" class="text-accent underline decoration-emerald-400/30 underline-offset-4 hover:decoration-emerald-300">MyBankStatementConverter.com</a>{" "}
            — a privacy-first platform that processes sensitive financial data under strict security and encryption.
            Outside of work, I draw, paint and play padel.
          </p>
        </div>

        <div class="rise" style="--d: 0.3s">
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="group inline-flex items-center gap-2 rounded-full border border-line bg-surface px-5 py-2.5 text-sm text-soft transition hover:border-emerald-400/40 hover:bg-emerald-400/10 hover:text-fg"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal">
          <p class="text-sm font-medium tracking-widest text-emerald-400 uppercase light:text-accent">Services</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
            From strategy <span class="font-serif font-normal italic text-gradient">to shipped product</span>
          </h2>
          <p class="mt-4 max-w-2xl text-mist">Advise, staff, or build — engage me for one or all three.</p>
        </div>
        <div class="reveal" style="--d: 0.06s">
          <div class="card mt-8 grid divide-y divide-line overflow-hidden sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald-300 to-transparent" aria-hidden="true"></span>
            {offerings.map((o, i) => (
              <div class="p-6 sm:p-8">
                <span class="font-serif text-4xl italic text-gradient">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="mt-4 text-lg font-medium text-fg">{o.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-mist">{o.desc}</p>
              </div>
            ))}
          </div>
        </div>
        <p class="reveal mt-14 text-sm font-medium tracking-widest text-emerald-400 uppercase light:text-accent">What I deliver</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s, i) => (
            <div class:list={["reveal h-full", i === 0 && "sm:col-span-2"]} style={`--d: ${i * 0.06}s`}>
              <article class="card h-full p-6">
                <div class="inline-flex size-11 items-center justify-center rounded-xl border border-emerald-400/20 bg-emerald-400/10 text-accent">
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
                </div>
                <h3 class="mt-5 text-lg font-medium text-fg">{s.title}</h3>
                <p class="mt-2 text-sm font-medium text-accent">{s.tagline}</p>
                <p class="mt-3 text-sm leading-relaxed text-mist">{s.desc}</p>
              </article>
            </div>
          ))}
        </div>
        <p class="reveal mt-12 text-center text-sm text-mist">
          Not sure which fits? We'll map it out together. <a href="#contact" class="font-medium text-accent hover:text-emerald-200 light:hover:text-emerald-900">Let's talk →</a>
        </p>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal">
          <p class="text-sm font-medium tracking-widest text-emerald-400 uppercase light:text-accent">Projects</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
            Things I've <span class="font-serif font-normal italic text-gradient">shipped</span>
          </h2>
        </div>
        <div class="mt-12 grid gap-5">
          {projects.map((p) => (
            <div class="reveal">
              <a href={p.href} target="_blank" rel="noopener" class="card group block overflow-hidden p-6 sm:p-10">
                <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
                <p class="relative text-xs font-medium tracking-widest text-accent uppercase">{p.tag}</p>
                <h3 class="relative mt-3 flex items-center gap-2 text-xl font-semibold text-fg [overflow-wrap:anywhere] sm:text-3xl">
                  {p.name}
                  <svg class="size-5 shrink-0 text-mist transition group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                </h3>
                <p class="relative mt-4 max-w-2xl leading-relaxed text-mist">{p.desc}</p>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="py-24 sm:py-32">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="reveal">
          <p class="text-sm font-medium tracking-widest text-emerald-400 uppercase light:text-accent">Experience</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
            16+ years across <span class="font-serif font-normal italic text-gradient">Germany & Singapore</span>
          </h2>
        </div>
        <ol class="relative mt-12 border-l border-line pl-8">
          {experience.map((e, i) => (
            <li class="relative pb-10 last:pb-0">
              <span class="absolute top-1.5 -left-[37px] size-2.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_var(--color-ink),0_0_16px_rgb(52_211_153/0.7)]"></span>
              <div class="reveal" style={`--d: ${i * 0.05}s`}>
                <h3 class="text-lg font-medium text-fg [overflow-wrap:anywhere]">{e.org}</h3>
                <p class="mt-1 text-sm text-soft">
                  {e.role}{e.location && <span class="text-mist"> · {e.location}</span>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="px-4 py-24 sm:px-6 sm:py-32">
      <div class="reveal mx-auto max-w-4xl">
        <div class="card overflow-hidden px-6 py-16 text-center sm:px-12">
          <div class="aurora pointer-events-none absolute inset-0 opacity-60"></div>
          <h2 class="relative text-3xl font-semibold tracking-tight text-fg sm:text-5xl">
            Let's grow your business, <span class="font-serif font-normal italic text-gradient">together</span>
          </h2>
          <p class="relative mx-auto mt-5 max-w-xl text-mist">
            Need AI systems built, a strategic tech roadmap, vetted developers, or a growth partner? Reach out — I'd love to hear what you're working on.
          </p>
          <div class="relative mt-10 flex flex-wrap items-center justify-center gap-3">
            {socials.filter((s) => s.label !== "GitHub").map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class:list={[
                  "inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm transition",
                  ["LinkedIn", "Threads"].includes(s.label)
                    ? "bg-gradient-to-r from-emerald-400 to-teal-400 font-semibold text-slate-950 shadow-[0_8px_30px_-8px_rgb(52_211_153/0.6)] hover:brightness-110"
                    : "border border-line bg-surface font-medium text-soft hover:border-emerald-400/40 hover:bg-emerald-400/10 hover:text-fg",
                ]}
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                Message me on {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-8 text-center text-xs text-mist">
    © {new Date().getFullYear()} Wandi Susanto · Built with Astro
  </footer>
</Layout>
