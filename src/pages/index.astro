---
import Layout from "../layouts/Layout.astro";
import Reveal from "../components/Reveal";

const avatar = "https://github.com/wandisusanto.png";

const nav = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];

const socials = [
  {
    label: "LinkedIn",
    href: "https://id.linkedin.com/in/wandisusanto",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "X",
    href: "https://x.com/wandikang",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
];

// Icon bodies are Lucide (24x24, stroke) paths.
const services = [
  {
    title: "Fullstack Web & Mobile Apps",
    desc: "From idea to production: modern web apps, mobile apps, APIs and the cloud infrastructure behind them.",
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: "E-commerce Stores",
    desc: "Fast, conversion-focused online stores with payments, inventory and the integrations you need to sell.",
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: "AI & Machine Learning",
    desc: "Recommendation, forecasting, NLP and LLM-powered features — designed, trained and shipped to production.",
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
  },
  {
    title: "Data Science & Analytics",
    desc: "Turn raw data into decisions: pipelines, experimentation, dashboards and models that move metrics.",
    icon: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  },
  {
    title: "Workflow Automation",
    desc: "Automate the repetitive work — connect your tools, eliminate manual steps and free up your team.",
    icon: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  },
];

const projects = [
  {
    name: "MyBankStatementConverter.com",
    href: "https://mybankstatementconverter.com",
    tag: "SaaS · Solo-developed",
    desc: "Converts bank statement PDFs into clean Excel or CSV spreadsheets in seconds. Built for accountants and bookkeepers, with batch uploads and privacy by design — transaction data never enters the database.",
  },
];

const experience = [
  { org: "MyBankStatementConverter.com", role: "Founder & solo developer" },
  { org: "Doctor Anywhere", role: "Head of AI & Data Science", location: "Singapore" },
  { org: "Alibaba / Lazada", role: "Senior Manager, Machine Learning & Data Science", location: "Singapore" },
  { org: "Traveloka", role: "Principal Data Scientist", location: "Singapore" },
  { org: "AstraZeneca", role: "Lead Data Scientist", location: "Germany" },
  { org: "Max Planck Institute for Informatics", role: "Graduate studies & research", location: "Germany" },
];

---

<Layout>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-ink/70 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
      <a href="#about" class="font-serif text-2xl tracking-tight text-white">Wandi Susanto</a>
      <ul class="hidden gap-8 text-sm text-mist md:flex">
        {nav.map((n) => <li><a href={n.href} class="transition-colors hover:text-white">{n.label}</a></li>)}
      </ul>
      <details class="group relative md:hidden">
        <summary class="cursor-pointer list-none rounded-lg p-2 text-mist hover:text-white [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-48 rounded-xl border border-line bg-panel/95 p-2 text-sm shadow-2xl backdrop-blur-xl">
          {nav.map((n) => <li><a href={n.href} class="block rounded-lg px-3 py-2 text-mist hover:bg-white/5 hover:text-white">{n.label}</a></li>)}
        </ul>
      </details>
    </nav>
  </header>

  <main>
    <!-- Hero / About -->
    <section id="about" class="relative overflow-hidden pt-32 pb-24 sm:pt-40 sm:pb-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="aurora absolute -inset-x-1/4 -top-1/4 h-[120%]"></div>
        <div class="grid-bg absolute inset-0"></div>
      </div>

      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
        <Reveal client:load>
          <div class="relative mx-auto size-32 sm:size-40">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-emerald-400 via-teal-400 to-cyan-400 opacity-70 blur-md"></div>
            <img
              src={avatar}
              alt="Portrait of Wandi Susanto"
              width="160"
              height="160"
              class="relative size-full rounded-full border-2 border-ink object-cover"
            />
          </div>
        </Reveal>

        <Reveal client:load delay={0.1}>
          <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/5 px-4 py-1.5 text-xs font-medium tracking-wide text-emerald-300">
            <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
            Open to projects & partnerships
          </p>
          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            Hi, I'm Wandi.<br />
            <span class="font-serif text-5xl font-normal italic sm:text-7xl"><span class="text-gradient">I build intelligent products.</span></span>
          </h1>
        </Reveal>

        <Reveal client:load delay={0.2}>
          <p class="mx-auto mt-8 max-w-2xl text-base leading-relaxed text-mist sm:text-lg">
            Tech entrepreneur and <span class="text-slate-200">Machine Learning Engineer & Data Scientist</span> with
            over 15 years of professional experience in Germany and Singapore, at companies like{" "}
            <span class="text-slate-200">AstraZeneca</span>, <span class="text-slate-200">Alibaba/Lazada</span> and{" "}
            <span class="text-slate-200">Traveloka</span>. I graduated from and did research at the{" "}
            <span class="text-slate-200">Max Planck Institute for Informatics</span>, and solo-developed the SaaS{" "}
            <a href="https://mybankstatementconverter.com" target="_blank" rel="noopener" class="text-emerald-300 underline decoration-emerald-400/30 underline-offset-4 hover:decoration-emerald-300">MyBankStatementConverter.com</a>.
            In my free time, I enjoy drawing and painting.
          </p>
        </Reveal>

        <Reveal client:load delay={0.3}>
          <div class="mt-10 flex items-center justify-center gap-3">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="group inline-flex items-center gap-2 rounded-full border border-line bg-white/[0.03] px-5 py-2.5 text-sm text-slate-200 transition hover:border-emerald-400/40 hover:bg-emerald-400/10 hover:text-white"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                {s.label}
              </a>
            ))}
          </div>
          <p class="mx-auto mt-8 max-w-xl text-sm text-mist">
            Looking to hire a developer, bring in an expert, or explore a partnership? <a href="#contact" class="font-medium text-emerald-300 hover:text-emerald-200">Let's talk →</a>
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <Reveal client:load>
          <p class="text-sm font-medium tracking-widest text-emerald-400 uppercase">Services</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            What I can <span class="font-serif font-normal italic text-gradient">build for you</span>
          </h2>
        </Reveal>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s, i) => (
            <Reveal client:load delay={i * 0.06} className="h-full">
              <article class="card h-full p-6">
                <div class="inline-flex size-11 items-center justify-center rounded-xl border border-emerald-400/20 bg-emerald-400/10 text-emerald-300">
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
                </div>
                <h3 class="mt-5 text-lg font-medium text-white">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-mist">{s.desc}</p>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <Reveal client:load>
          <p class="text-sm font-medium tracking-widest text-emerald-400 uppercase">Projects</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Things I've <span class="font-serif font-normal italic text-gradient">shipped</span>
          </h2>
        </Reveal>
        <div class="mt-12 grid gap-5">
          {projects.map((p) => (
            <Reveal client:load>
              <a href={p.href} target="_blank" rel="noopener" class="card group block overflow-hidden p-6 sm:p-10">
                <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
                <p class="relative text-xs font-medium tracking-widest text-emerald-300 uppercase">{p.tag}</p>
                <h3 class="relative mt-3 flex items-center gap-2 text-xl font-semibold text-white [overflow-wrap:anywhere] sm:text-3xl">
                  {p.name}
                  <svg class="size-5 shrink-0 text-mist transition group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                </h3>
                <p class="relative mt-4 max-w-2xl leading-relaxed text-mist">{p.desc}</p>
              </a>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="py-24 sm:py-32">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <Reveal client:load>
          <p class="text-sm font-medium tracking-widest text-emerald-400 uppercase">Experience</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            15+ years across <span class="font-serif font-normal italic text-gradient">Germany & Singapore</span>
          </h2>
        </Reveal>
        <ol class="relative mt-12 border-l border-line pl-8">
          {experience.map((e, i) => (
            <li class="relative pb-10 last:pb-0">
              <span class="absolute top-1.5 -left-[37px] size-2.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_var(--color-ink),0_0_16px_rgb(52_211_153/0.7)]"></span>
              <Reveal client:load delay={i * 0.05}>
                <h3 class="text-lg font-medium text-white [overflow-wrap:anywhere]">{e.org}</h3>
                <p class="mt-1 text-sm text-slate-300">
                  {e.role}{e.location && <span class="text-mist"> · {e.location}</span>}
                </p>
              </Reveal>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="px-4 py-24 sm:px-6 sm:py-32">
      <Reveal client:load className="mx-auto max-w-4xl">
        <div class="card overflow-hidden px-6 py-16 text-center sm:px-12">
          <div class="aurora pointer-events-none absolute inset-0 opacity-60"></div>
          <h2 class="relative text-3xl font-semibold tracking-tight text-white sm:text-5xl">
            Let's build something <span class="font-serif font-normal italic text-gradient">together</span>
          </h2>
          <p class="relative mx-auto mt-5 max-w-xl text-mist">
            Hiring a developer, need an expert on AI/ML and data, or exploring a partnership? Reach out — I'd love to hear what you're working on.
          </p>
          <div class="relative mt-10 flex flex-wrap items-center justify-center gap-3">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-emerald-400 to-teal-400 px-6 py-3 text-sm font-semibold text-ink shadow-[0_8px_30px_-8px_rgb(52_211_153/0.6)] transition hover:brightness-110"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                Message me on {s.label}
              </a>
            ))}
          </div>
        </div>
      </Reveal>
    </section>
  </main>

  <footer class="border-t border-line py-8 text-center text-xs text-mist">
    © {new Date().getFullYear()} Wandi Susanto · Built with Astro
  </footer>
</Layout>
